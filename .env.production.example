PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://manga.example.com
# Ajustar al numero o subred exacta de proxies del proveedor. Usar false si la API queda expuesta directamente.
TRUST_PROXY=1
INCLUDE_ERROR_STACKS=false

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_MAX_KEYS=10000
IMAGE_PROXY_RATE_LIMIT_MAX_REQUESTS=90

MANGADEX_ENABLED=true
COMICK_ENABLED=true
INMANGA_ENABLED=false
LEERMANGA_ENABLED=false
TUMANGAONLINE_ENABLED=false
MANGA_SCRAPER_ENABLED=false
MANGPI_ENABLED=false

MYMANGAONLINE_PROVIDER_ENABLED=false
INMANGA_PROVIDER_ENABLED=false
LEERMANGA_PROVIDER_ENABLED=false
TUMANGAONLINE_PROVIDER_ENABLED=false

MANGADEX_BASE_URL=https://api.mangadex.org
COMICK_BASE_URL=https://comick.live
COMICK_IMAGE_BASE_URL=https://meo.comick.pictures

REQUEST_TIMEOUT_MS=15000
SOURCE_SEARCH_TIMEOUT_MS=4500
IMAGE_PROXY_MAX_BYTES=15728640
IMAGE_PROXY_CONCURRENCY=3
IMAGE_PROXY_MAX_QUEUE=60
IMAGE_PROXY_REQUEST_DELAY_MS=75
QUERY_CACHE_TTL_MS=120000
QUERY_CACHE_MAX_ENTRIES=500
QUERY_CACHE_MAX_PENDING=100
COMICK_MAX_QUEUE=40

TRANSLATION_ENABLED=false
TRANSLATION_API_URL=https://api.mymemory.translated.net/get
TRANSLATION_CACHE_TTL_MS=86400000

MANGADEX_DEFAULT_LANGUAGE=es
ALLOWED_LANGUAGES=es,en,pt-br,fr
DEFAULT_CHAPTER_QUALITY=data
